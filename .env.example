# ================================
# DermicaPro - Docker Environment Variables
# ================================
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to git!

# ================================
# Database Configuration
# ================================
DB_USER=dermicapro
DB_PASSWORD=dermicapro123
DB_NAME=dermicapro_db
DB_PORT=5432

# Full database URL (used by Prisma)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# ================================
# Backend Configuration
# ================================
NODE_ENV=development
BACKEND_PORT=5000

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# ================================
# Frontend Configuration
# ================================
FRONTEND_PORT=5173

# API URL for frontend
VITE_API_URL=http://localhost:5000

# ================================
# Prisma Studio (Optional)
# ================================
PRISMA_STUDIO_PORT=5555

# ================================
# Production Configuration
# ================================
# Uncomment and configure for production deployment

# NODE_ENV=production
# CORS_ORIGIN=https://yourdomain.com
# VITE_API_URL=https://api.yourdomain.com
# JWT_SECRET=generate-a-strong-random-secret-at-least-32-characters-long

# ================================
# Observabilidad (Grafana + Loki + Prometheus)
# ================================
# Ver OBSERVABILIDAD.md para el detalle del stack.

# Token que protege GET /metrics en el backend. Debe ser el mismo valor que lee
# Prometheus. Generar con: openssl rand -hex 32
METRICS_TOKEN=

# Umbrales de las métricas de negocio. Una cita se considera atascada si sigue
# en in_progress pasadas estas horas desde su hora programada; una comisión se
# considera olvidada si sigue en pending pasados estos días.
METRICS_STUCK_APPOINTMENT_HOURS=6
METRICS_AGED_COMMISSION_DAYS=7
METRICS_BUSINESS_INTERVAL_MS=60000

# Ventana sobre la que alerta SesionesPorEncimaDelPaquete. El acumulado
# histórico no sirve para alertar: una sesión mal creada no se corrige sola, así
# que la alerta quedaría encendida para siempre. Con esta ventana se apaga una
# vez revisada y vuelve a sonar si el problema se repite.
METRICS_OVER_PACKAGE_WINDOW_HOURS=24

# Credenciales de Grafana. La contraseña es obligatoria: sin ella el stack no
# arranca.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DOMAIN=grafana.dermicapro.app
GRAFANA_ROOT_URL=https://grafana.dermicapro.app

# Webhook de n8n al que Alertmanager envía las alertas de ESTE sistema (ERP).
# El CRM, en el otro VPS, usa el mismo n8n pero un webhook distinto.
# Si n8n corre en el propio VPS fuera de Docker, usar host.docker.internal.
N8N_ALERT_WEBHOOK=https://n8n.dermicapro.online/webhook/erp/health

# Red donde viven backend y PostgreSQL. En producción es
# dermicapro-prod-network; para probar en local, la red del compose de
# desarrollo (normalmente dermicapro-intranet_dermicapro-network).
APP_NETWORK=dermicapro-prod-network
TRAEFIK_NETWORK=traefik-network

# PostgreSQL para el exporter de métricas. El usuario debe ser un rol de sólo
# lectura con pg_monitor, nunca el dueño de la base; el SQL para crearlo está
# en OBSERVABILIDAD.md. Si se dejan vacíos se usa el usuario de la aplicación.
DB_HOST=dermicapro-db-prod
DB_EXPORTER_USER=dermicapro_monitor
DB_EXPORTER_PASSWORD=

# ================================
# Splunk Logging (obsoleto)
# ================================
# Los contenedores ya no usan el driver de logs de splunk: ahora Alloy lee los
# logs de Docker y los envía a Loki. Estas variables sólo siguen aquí por si se
# mantiene la instancia de Splunk para consultar el histórico.
SPLUNK_TOKEN=your-splunk-hec-token-here
SPLUNK_URL=https://<splunk-server-ip>:8088

# ================================
# Notes
# ================================
# 1. For local development, the default values should work
# 2. For production, generate strong passwords and secrets
# 3. Use environment-specific .env files (.env.production, .env.staging)
# 4. Never expose database ports (5432) in production
# 5. Use docker secrets or vault for sensitive data in production
